#!/usr/bin/env bash
# Ephnim on a Raspberry Pi — one command for the whole appliance.
# Run as the desktop user (not root); it asks for sudo where it needs it.
#
#   ephnim install      first time: packages, build, web server, kiosk, boot
#   ephnim update       git pull, rebuild, restart server and kiosk
#   ephnim build        rebuild the app only (npm ci + npm run build)
#   ephnim restart      restart the web server and reload the kiosk
#   ephnim desktop      leave the kiosk now and show the desktop (this session)
#   ephnim kiosk        start the kiosk now (from the desktop, or over SSH)
#   ephnim enable       start the kiosk at every login (installed by install)
#   ephnim disable      stop starting it — the normal desktop comes back
#   ephnim audio [name] make the USB audio adapter (or the named sink) default
#   ephnim pads [on]    map the 8 GPIO switches to the pads' keys 1–8 (reboot)
#   ephnim pads status  wiring, whether the mapping is live, each switch now
#   ephnim pads test    show every press as it arrives (Ctrl+C to stop)
#   ephnim pads off     remove the mapping again (reboot)
#   ephnim status       what is running, what is playing where
#   ephnim logs         web server and kiosk logs
#   ephnim uninstall    disable + remove the web server service
#
# Everything it installs is listed in README.md, and all of it is removed by
# `ephnim uninstall` (packages excepted).
set -euo pipefail

PI_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
APP_DIR=$(cd "$PI_DIR/../app" && pwd)
REPO_DIR=$(git -C "$PI_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$PI_DIR/../..")
SERVICE=ephnim-web
UNIT=/etc/systemd/system/$SERVICE.service
PORT=4173
URL="http://127.0.0.1:$PORT/?kiosk"
MARK="# ephnim-kiosk"

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
LABWC_AUTOSTART=$CONFIG/labwc/autostart
XDG_AUTOSTART=$CONFIG/autostart/ephnim-kiosk.desktop
MENU_ENTRY=${XDG_DATA_HOME:-$HOME/.local/share}/applications/ephnim.desktop
DESKTOP_DIR=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
DESKTOP_ICON=$DESKTOP_DIR/ephnim.desktop
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/ephnim
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ephnim

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31mxx\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "run as the desktop user, not root (it uses sudo itself)"

# ── Packages ──────────────────────────────────────────────────────────

ensure_packages() {
  local missing=()
  command -v node >/dev/null || missing+=(nodejs)
  command -v npm >/dev/null || missing+=(npm)
  command -v curl >/dev/null || missing+=(curl)
  command -v pactl >/dev/null || missing+=(pulseaudio-utils)
  command -v chromium >/dev/null || command -v chromium-browser >/dev/null || missing+=(chromium)
  if [ ${#missing[@]} -gt 0 ]; then
    say "installing: ${missing[*]}"
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  fi
  local major
  major=$(node -p 'process.versions.node.split(".")[0]')
  [ "$major" -ge 18 ] || die "Node $major is too old (Vite needs 18+): see README.md, 'Node.js'"
}

# ── Build ─────────────────────────────────────────────────────────────

build() {
  say "building the app ($APP_DIR)"
  (cd "$APP_DIR" && npm ci --no-audit --no-fund && npm run build)
}

# ── Web server (systemd) ──────────────────────────────────────────────

install_service() {
  say "installing $SERVICE.service"
  sudo tee "$UNIT" >/dev/null <<EOF
# Written by $PI_DIR/ephnim — remove with \`ephnim uninstall\`.
[Unit]
Description=Ephnim local web server (the kiosk app)
After=local-fs.target
# Never give up restarting it.
StartLimitIntervalSec=0

[Service]
Type=simple
User=$(id -un)
WorkingDirectory=$PI_DIR
Environment=EPHNIM_PORT=$PORT
ExecStart=$(command -v node) $PI_DIR/serve.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable "$SERVICE" >/dev/null
  sudo systemctl restart "$SERVICE"
}

# ── Kiosk autostart ───────────────────────────────────────────────────

enable_kiosk() {
  chmod +x "$PI_DIR/kiosk.sh" "$PI_DIR/ephnim"
  mkdir -p "$(dirname "$LABWC_AUTOSTART")" "$(dirname "$XDG_AUTOSTART")"

  # labwc (Wayland): the session's own autostart. A file of the user's that
  # is not ours is kept aside and put back by `disable`.
  if [ -f "$LABWC_AUTOSTART" ] && ! grep -q "$MARK" "$LABWC_AUTOSTART"; then
    cp "$LABWC_AUTOSTART" "$LABWC_AUTOSTART.before-ephnim"
    say "kept your labwc autostart as $LABWC_AUTOSTART.before-ephnim"
  fi
  if [ -f "$LABWC_AUTOSTART.before-ephnim" ]; then
    { cat "$LABWC_AUTOSTART.before-ephnim"; echo; } >"$LABWC_AUTOSTART"
  else
    : >"$LABWC_AUTOSTART"
  fi
  cat >>"$LABWC_AUTOSTART" <<EOF
$MARK — added by $PI_DIR/ephnim; \`ephnim disable\` removes it.
"$PI_DIR/kiosk.sh" &
EOF

  # X11 (and any other XDG desktop): the standard autostart entry. Under
  # labwc both may fire; the launcher lets only one run.
  cat >"$XDG_AUTOSTART" <<EOF
$MARK — added by $PI_DIR/ephnim; \`ephnim disable\` removes it.
[Desktop Entry]
Type=Application
Name=Ephnim kiosk
Exec="$PI_DIR/kiosk.sh"
X-GNOME-Autostart-enabled=true
EOF
  install_shortcuts
  say "kiosk starts at login; the Ephnim icon on the desktop starts it again"
}

# The way back from the desktop: an Ephnim icon on it, and the same entry in
# the menu (Sound & Video). Both just start the kiosk again.
install_shortcuts() {
  mkdir -p "$(dirname "$MENU_ENTRY")" "$DESKTOP_DIR"
  cat >"$MENU_ENTRY" <<EOF
$MARK — added by $PI_DIR/ephnim; \`ephnim uninstall\` removes it.
[Desktop Entry]
Type=Application
Name=Ephnim
Comment=Back to the instrument, full screen
Exec="$PI_DIR/ephnim" kiosk
Icon=audio-x-generic
Terminal=false
Categories=AudioVideo;Audio;
EOF
  cp "$MENU_ENTRY" "$DESKTOP_ICON"
  chmod +x "$MENU_ENTRY" "$DESKTOP_ICON"
}

remove_shortcuts() {
  rm -f "$MENU_ENTRY" "$DESKTOP_ICON"
}

disable_kiosk() {
  if [ -f "$LABWC_AUTOSTART.before-ephnim" ]; then
    mv -f "$LABWC_AUTOSTART.before-ephnim" "$LABWC_AUTOSTART"
  elif [ -f "$LABWC_AUTOSTART" ] && grep -q "$MARK" "$LABWC_AUTOSTART"; then
    rm -f "$LABWC_AUTOSTART"
  fi
  rm -f "$XDG_AUTOSTART"
  say "kiosk no longer starts at login (the normal desktop comes back next login)"
}

# ── Boot ──────────────────────────────────────────────────────────────

configure_boot() {
  if ! command -v raspi-config >/dev/null; then
    warn "raspi-config not found: set 'Desktop Autologin' and 'Screen Blanking: off' yourself"
    return
  fi
  say "boot to the desktop, logged in automatically; screen never blanks"
  sudo raspi-config nonint do_boot_behaviour B4
  sudo raspi-config nonint do_blanking 1
}

# ── Kiosk control ─────────────────────────────────────────────────────

chromium_pids() { pgrep -f -- "--user-data-dir=.*/ephnim/chromium" || true; }

stop_chromium() {
  local pids
  pids=$(chromium_pids)
  [ -n "$pids" ] || return 1
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
}

reload_kiosk() {
  mkdir -p "$RUN"
  touch "$RUN/restart"
  stop_chromium || rm -f "$RUN/restart"
}

# Find the graphical session from an SSH shell.
session_env() {
  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    local runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    if [ -S "$runtime/wayland-0" ]; then
      export WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=$runtime
    elif [ -S "$runtime/wayland-1" ]; then
      export WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=$runtime
    else
      export DISPLAY=:0
    fi
    [ -S "$runtime/bus" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
  fi
  return 0
}

# ── Audio ─────────────────────────────────────────────────────────────

audio() {
  command -v pactl >/dev/null || die "pactl missing: sudo apt install pulseaudio-utils"
  local want=${1:-} sink
  echo "Output devices:"
  pactl list short sinks | awk '{print "  " $2}'
  if [ -n "$want" ]; then
    sink=$want
  else
    sink=$(pactl list short sinks | awk '{print $2}' | grep -i usb | head -n1 || true)
  fi
  if [ -z "$sink" ]; then
    warn "no USB audio output found — plug the adapter in, or pass a name from the list"
    return 1
  fi
  pactl set-default-sink "$sink"
  say "default output: $sink (remembered across reboots)"
}

# ── Mechanical pads (GPIO) ────────────────────────────────────────────
# Each pad is a plain switch between one GPIO and GND. The kernel's gpio-key
# overlay turns each GPIO into a key — KEY_1 … KEY_8 — with the pin's own
# pull-up and the driver's debounce, so Chromium sees the keys 1–8 that the
# app already plays (SelectorScreen.tsx, PAD_KEYS). Nothing runs for it.
#
# Pads in the app's order (top row 1–4, bottom row 5–8); BCM numbers. The
# defaults sit on header pins 29–40, clear of I2C, SPI and the UART. Override
# with EPHNIM_PAD_GPIOS="a b c d e f g h" before `ephnim pads on`.
read -r -a PAD_GPIOS <<<"${EPHNIM_PAD_GPIOS:-5 6 13 19 12 16 20 21}"
PAD_BEGIN="# >>> ephnim pads"
PAD_END="# <<< ephnim pads"

boot_config() {
  local f
  for f in /boot/firmware/config.txt /boot/config.txt; do
    [ -f "$f" ] && { echo "$f"; return; }
  done
  die "no /boot/firmware/config.txt — is this Raspberry Pi OS?"
}

# Header pin of a BCM GPIO (40-pin header, Pi 2 and later).
header_pin() {
  case $1 in
    2) echo 3 ;; 3) echo 5 ;; 4) echo 7 ;; 5) echo 29 ;; 6) echo 31 ;; 7) echo 26 ;;
    8) echo 24 ;; 9) echo 21 ;; 10) echo 19 ;; 11) echo 23 ;; 12) echo 32 ;; 13) echo 33 ;;
    14) echo 8 ;; 15) echo 10 ;; 16) echo 36 ;; 17) echo 11 ;; 18) echo 12 ;; 19) echo 35 ;;
    20) echo 38 ;; 21) echo 40 ;; 22) echo 15 ;; 23) echo 16 ;; 24) echo 18 ;; 25) echo 22 ;;
    26) echo 37 ;; 27) echo 13 ;; *) echo "?" ;;
  esac
}

check_pad_gpios() {
  [ ${#PAD_GPIOS[@]} -eq 8 ] || die "EPHNIM_PAD_GPIOS needs 8 GPIOs, got ${#PAD_GPIOS[@]}: ${PAD_GPIOS[*]}"
  local g seen=" "
  for g in "${PAD_GPIOS[@]}"; do
    [[ $g =~ ^[0-9]+$ ]] && [ "$g" -ge 2 ] && [ "$g" -le 27 ] || die "not a header GPIO (2–27): $g"
    [[ $seen == *" $g "* ]] && die "GPIO $g is listed twice"
    seen+="$g "
  done
}

pads_block() {
  local i g
  echo "$PAD_BEGIN — written by $PI_DIR/ephnim; \`ephnim pads off\` removes it."
  echo "# Pad n: switch between the GPIO below and GND. keycode 2–9 = KEY_1–KEY_8."
  echo "[all]"
  for i in "${!PAD_GPIOS[@]}"; do
    g=${PAD_GPIOS[$i]}
    echo "dtoverlay=gpio-key,gpio=$g,active_low=1,gpio_pull=up,label=PAD$((i + 1)),keycode=$((i + 2))"
  done
  echo "$PAD_END"
}

# config.txt without our block.
strip_pads() { awk -v b="$PAD_BEGIN" -v e="$PAD_END" 'index($0,b)==1{skip=1} !skip{print} index($0,e)==1{skip=0}' "$1"; }

pads_on() {
  check_pad_gpios
  local cfg tmp
  cfg=$(boot_config)
  [ -f "$cfg.before-ephnim-pads" ] || sudo cp "$cfg" "$cfg.before-ephnim-pads"
  tmp=$(mktemp)
  { strip_pads "$cfg"; pads_block; } >"$tmp"
  if cmp -s "$tmp" "$cfg"; then
    rm -f "$tmp"
    say "pads already mapped in $cfg"
  else
    sudo cp "$tmp" "$cfg"
    rm -f "$tmp"
    say "pads mapped in $cfg (your previous file: $cfg.before-ephnim-pads)"
    warn "reboot to apply: sudo reboot"
  fi
  pads_wiring
}

pads_off() {
  local cfg tmp
  cfg=$(boot_config)
  grep -qF "$PAD_BEGIN" "$cfg" || { say "no pad mapping in $cfg"; return 0; }
  tmp=$(mktemp)
  strip_pads "$cfg" >"$tmp"
  sudo cp "$tmp" "$cfg"
  rm -f "$tmp"
  say "pad mapping removed from $cfg — reboot to apply"
}

pads_wiring() {
  local i g
  echo "Wiring — one leg of each switch to its pin, the other to any GND (pins 30, 34, 39):"
  for i in "${!PAD_GPIOS[@]}"; do
    g=${PAD_GPIOS[$i]}
    printf '  pad %d  key %d  GPIO%-2s  header pin %s\n' $((i + 1)) $((i + 1)) "$g" "$(header_pin "$g")"
  done
}

pads_status() {
  local cfg i g level
  cfg=$(boot_config)
  pads_wiring
  echo
  if grep -qF "$PAD_BEGIN" "$cfg"; then echo "config.txt : mapped ($cfg)"; else echo "config.txt : not mapped (ephnim pads on)"; fi
  # Each overlay instance shows up as its own input device once booted.
  local live
  live=$(grep -c -i '^N: Name=.*gpio.key' /proc/bus/input/devices 2>/dev/null || true)
  echo "live keys  : ${live:-0} GPIO key device(s) (8 expected after a reboot)"
  if command -v pinctrl >/dev/null; then
    echo "switches now (lo = pressed):"
    for i in "${!PAD_GPIOS[@]}"; do
      g=${PAD_GPIOS[$i]}
      level=$(pinctrl get "$g" 2>/dev/null | sed -n 's/.*| *\(hi\|lo\).*/\1/p')
      printf '  pad %d  GPIO%-2s %s\n' $((i + 1)) "$g" "${level:-?}"
    done
  fi
}

pads_test() {
  command -v libinput >/dev/null || { say "installing libinput-tools"; sudo apt-get install -y libinput-tools; }
  say "press each pad — expect KEY_1 … KEY_8 pressed/released. Ctrl+C to stop."
  sudo libinput debug-events --show-keycodes | grep --line-buffered -E 'KEYBOARD_KEY'
}

# ── Status / logs ─────────────────────────────────────────────────────

status() {
  echo "web server : $(systemctl is-active "$SERVICE" 2>/dev/null || true) ($URL)"
  if curl -fsS -o /dev/null --max-time 2 "$URL"; then echo "responding : yes"; else echo "responding : no"; fi
  if [ -n "$(chromium_pids)" ]; then echo "kiosk      : running"; else echo "kiosk      : not running"; fi
  if grep -qs "$MARK" "$LABWC_AUTOSTART" "$XDG_AUTOSTART"; then echo "autostart  : on"; else echo "autostart  : off"; fi
  echo "session    : ${XDG_SESSION_TYPE:-?} $(pgrep -x labwc >/dev/null && echo '(labwc running)')"
  if command -v pactl >/dev/null; then echo "audio out  : $(pactl get-default-sink 2>/dev/null || echo '?')"; fi
  echo "build      : $(git -C "$REPO_DIR" log -1 --format='%h %s' 2>/dev/null | cut -c1-70)"
}

logs() {
  echo "── web server (journalctl -u $SERVICE) ──"
  journalctl -u "$SERVICE" -n 40 --no-pager 2>/dev/null || sudo journalctl -u "$SERVICE" -n 40 --no-pager
  echo
  echo "── kiosk ($STATE/kiosk.log) ──"
  tail -n 40 "$STATE/kiosk.log" 2>/dev/null || echo "(no kiosk log yet)"
}

# ── Commands ──────────────────────────────────────────────────────────

cmd=${1:-help}
shift || true
case "$cmd" in
  install)
    ensure_packages
    build
    install_service
    enable_kiosk
    configure_boot
    audio || true
    say "done — reboot to start Ephnim: sudo reboot"
    ;;
  update)
    say "pulling $(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD)"
    git -C "$REPO_DIR" pull --ff-only
    build
    install_shortcuts
    sudo systemctl restart "$SERVICE"
    reload_kiosk
    say "updated: $(git -C "$REPO_DIR" log -1 --format='%h %s')"
    ;;
  build) build ;;
  restart)
    sudo systemctl restart "$SERVICE"
    reload_kiosk
    ;;
  desktop)
    mkdir -p "$RUN"
    touch "$RUN/exit-to-desktop"
    stop_chromium || { rm -f "$RUN/exit-to-desktop"; warn "kiosk is not running"; }
    ;;
  kiosk)
    session_env
    setsid -f "$PI_DIR/kiosk.sh" >/dev/null 2>&1
    say "kiosk starting (log: $STATE/kiosk.log)"
    ;;
  enable) enable_kiosk ;;
  disable) disable_kiosk ;;
  audio) audio "$@" ;;
  pads)
    case ${1:-on} in
      on) pads_on ;;
      off) pads_off ;;
      status) pads_status ;;
      test) pads_test ;;
      *) die "ephnim pads [on|status|test|off]" ;;
    esac
    ;;
  status) status ;;
  logs) logs ;;
  uninstall)
    disable_kiosk
    remove_shortcuts
    pads_off
    stop_chromium || true
    if [ -f "$UNIT" ]; then
      sudo systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true
      sudo rm -f "$UNIT"
      sudo systemctl daemon-reload
    fi
    say "removed. The kiosk's browser profile is left at ~/.local/share/ephnim (saved patterns live there)"
    ;;
  help | -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0" ;;
  *) die "unknown command: $cmd (try: ephnim help)" ;;
esac
